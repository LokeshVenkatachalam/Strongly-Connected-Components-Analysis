+asymmetric_graph<asymmetric_vertex, gbbs::empty>
+read_unweighted_asymmetric_bgr_pair(
+    const char* forward_fname, const char* reverse_fname) {
+  const auto total_start = BgrClock::now();
+  auto stage_start = BgrClock::now();
+  MappedBgr forward_mapping(forward_fname);
+  MappedBgr reverse_mapping(reverse_fname);
+  const BgrView forward = parseBgr(forward_mapping, forward_fname);
+  const BgrView reverse = parseBgr(reverse_mapping, reverse_fname);
+  if (forward.n != reverse.n || forward.m != reverse.m) {
+    throw std::runtime_error(
+        "forward and reverse BGR dimensions do not match");
+  }
+  if (forward.n > std::numeric_limits<size_t>::max() ||
+      forward.m > std::numeric_limits<size_t>::max()) {
+    throw std::runtime_error("BGR dimensions exceed size_t");
+  }
+  printBgrPairStage("pair.map_and_validate_headers", stage_start);
+
+  const size_t n = static_cast<size_t>(forward.n);
+  const size_t m = static_cast<size_t>(forward.m);
+  vertex_data* v_out_data = nullptr;
+  vertex_data* v_in_data = nullptr;
+  uintE* out_edges = nullptr;
+  uintE* in_edges = nullptr;
+
+  auto release_allocations = [&]() {
+    if (v_out_data != nullptr) gbbs::free_array(v_out_data, n);
+    if (v_in_data != nullptr) gbbs::free_array(v_in_data, n);
+    if (out_edges != nullptr) gbbs::free_array(out_edges, m);
+    if (in_edges != nullptr) gbbs::free_array(in_edges, m);
+  };
+
+  try {
+    stage_start = BgrClock::now();
+    v_out_data = gbbs::new_array_no_init<vertex_data>(n);
+    v_in_data = gbbs::new_array_no_init<vertex_data>(n);
+    out_edges = gbbs::new_array_no_init<uintE>(m);
+    in_edges = gbbs::new_array_no_init<uintE>(m);
+    printBgrPairStage("pair.allocate_graph_arrays", stage_start);
+
+    auto populate_metadata = [&](const BgrView& view, vertex_data* metadata) {
+      std::atomic<bool> invalid(false);
+      parallel_for(0, n, [&](size_t i) {
+        const uint64_t begin = i == 0 ? 0 : loadOffset(view, i - 1);
+        const uint64_t end = loadOffset(view, i);
+        if (begin > end || end > m) {
+          invalid.store(true, std::memory_order_relaxed);
+        }
+        metadata[i].offset = static_cast<uintT>(begin);
+        metadata[i].degree = static_cast<uintT>(end - begin);
+      });
+      if ((n != 0 && loadOffset(view, n - 1) != m) ||
+          invalid.load(std::memory_order_relaxed)) {
+        throw std::runtime_error("invalid BGR CSR offsets");
+      }
+    };
+
+    stage_start = BgrClock::now();
+    populate_metadata(forward, v_out_data);
+    printBgrPairStage("pair.populate_out_metadata", stage_start);
+
+    stage_start = BgrClock::now();
+    populate_metadata(reverse, v_in_data);
+    printBgrPairStage("pair.populate_in_metadata", stage_start);
+
+    auto populate_edges = [&](const BgrView& view, uintE* edges) {
+      constexpr size_t kChunkEntries = 1U << 20;
+      const size_t chunks =
+          (m + kChunkEntries - 1) / kChunkEntries;
+      std::atomic<bool> invalid(false);
+      parallel_for(0, chunks, [&](size_t chunk) {
+        const size_t first = chunk * kChunkEntries;
+        const size_t last = std::min(first + kChunkEntries, m);
+        if (view.node_bytes == sizeof(uintE)) {
+          std::memcpy(
+              edges + first,
+              view.destinations + first * view.node_bytes,
+              (last - first) * sizeof(uintE));
+          for (size_t i = first; i < last; ++i) {
+            if (edges[i] >= n) {
+              invalid.store(true, std::memory_order_relaxed);
+            }
+          }
+        } else {
+          for (size_t i = first; i < last; ++i) {
+            const uint64_t destination = loadUnaligned<uint64_t>(
+                view.destinations + i * view.node_bytes);
+            if (destination >= n) {
+              invalid.store(true, std::memory_order_relaxed);
+            }
+            edges[i] = static_cast<uintE>(destination);
+          }
+        }
+      });
+      if (invalid.load(std::memory_order_relaxed)) {
+        throw std::runtime_error("BGR destination out of range");
+      }
+    };
+
+    stage_start = BgrClock::now();
+    populate_edges(forward, out_edges);
+    printBgrPairStage("pair.copy_and_validate_out_edges", stage_start);
+
+    stage_start = BgrClock::now();
+    populate_edges(reverse, in_edges);
+    printBgrPairStage("pair.copy_and_validate_in_edges", stage_start);
+  } catch (...) {
+    release_allocations();
+    throw;
+  }
+
+  printBgrPairStage("pair.total", total_start);
+  std::printf(
+      "GBBS_BGR_PAIR_RESULT {\"forward\":\"%s\",\"reverse\":\"%s\","
+      "\"vertices\":%zu,\"edges\":%zu}\n",
+      forward_fname, reverse_fname, n, m);
+  std::fflush(stdout);
+
+  return asymmetric_graph<asymmetric_vertex, gbbs::empty>(
+      v_out_data, v_in_data, n, m,
+      [=]() {
+        gbbs::free_array(v_out_data, n);
+        gbbs::free_array(v_in_data, n);
+        gbbs::free_array(out_edges, m);
+        gbbs::free_array(in_edges, m);
+      },
+      reinterpret_cast<std::tuple<uintE, gbbs::empty>*>(out_edges),
+      reinterpret_cast<std::tuple<uintE, gbbs::empty>*>(in_edges));
 }
 
