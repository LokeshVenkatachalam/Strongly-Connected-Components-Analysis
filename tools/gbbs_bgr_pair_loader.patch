+struct MappedBgr {
+  char* data;
+  size_t bytes;
+
+  explicit MappedBgr(const char* path) {
+    std::tie(data, bytes) = mmapStringFromFile(path);
+  }
+
+  ~MappedBgr() { unmmap(data, bytes); }
+
+  MappedBgr(const MappedBgr&) = delete;
+  MappedBgr& operator=(const MappedBgr&) = delete;
+};
+
+struct BgrView {
+  const unsigned char* offsets;
+  const unsigned char* destinations;
+  uint64_t n;
+  uint64_t m;
+  unsigned node_bytes;
+  unsigned edge_bytes;
+};
+
+template <class T>
+T loadUnaligned(const unsigned char* address) {
+  T value;
+  std::memcpy(&value, address, sizeof(value));
+  return value;
+}
+
+uint64_t checkedMultiply(uint64_t left, uint64_t right) {
+  if (right != 0 &&
+      left > std::numeric_limits<uint64_t>::max() / right) {
+    throw std::overflow_error("BGR size multiplication overflow");
+  }
+  return left * right;
+}
+
+uint64_t checkedAdd(uint64_t left, uint64_t right) {
+  if (right > std::numeric_limits<uint64_t>::max() - left) {
+    throw std::overflow_error("BGR size addition overflow");
+  }
+  return left + right;
+}
+
+BgrView parseBgr(const MappedBgr& mapping, const char* path) {
+  if (mapping.bytes < 9) {
+    throw std::runtime_error(std::string(path) + ": truncated BGR header");
+  }
+  const auto* data =
+      reinterpret_cast<const unsigned char*>(mapping.data);
+  const uint8_t flags = data[0];
+  if ((flags & ~0x0bU) != 0) {
+    throw std::runtime_error(std::string(path) + ": reserved BGR flags");
+  }
+  if ((flags & 0x08U) != 0) {
+    throw std::runtime_error(std::string(path) + ": weighted BGR unsupported");
+  }
+
+  const unsigned node_bytes = (flags & 0x01U) ? 8 : 4;
+  const unsigned edge_bytes = (flags & 0x02U) ? 8 : 4;
+  const uint64_t n =
+      node_bytes == 8 ? loadUnaligned<uint64_t>(data + 1)
+                      : loadUnaligned<uint32_t>(data + 1);
+  const uint64_t m =
+      edge_bytes == 8
+          ? loadUnaligned<uint64_t>(data + 1 + node_bytes)
+          : loadUnaligned<uint32_t>(data + 1 + node_bytes);
+  if (n > std::numeric_limits<uintE>::max()) {
+    throw std::runtime_error(std::string(path) + ": vertex IDs exceed uintE");
+  }
+  if (m > std::numeric_limits<uintT>::max()) {
+    throw std::runtime_error(std::string(path) + ": edge count exceeds uintT");
+  }
+
+  const uint64_t offsets_offset = 1 + node_bytes + edge_bytes;
+  const uint64_t destinations_offset = checkedAdd(
+      offsets_offset, checkedMultiply(n, edge_bytes));
+  const uint64_t expected = checkedAdd(
+      destinations_offset, checkedMultiply(m, node_bytes));
+  if (expected != mapping.bytes) {
+    throw std::runtime_error(std::string(path) + ": BGR size mismatch");
+  }
+
+  return {
+      data + offsets_offset,
+      data + destinations_offset,
+      n,
+      m,
+      node_bytes,
+      edge_bytes,
+  };
+}
+
+uint64_t loadOffset(const BgrView& view, uint64_t index) {
+  const auto* address = view.offsets + index * view.edge_bytes;
+  return view.edge_bytes == 8 ? loadUnaligned<uint64_t>(address)
+                              : loadUnaligned<uint32_t>(address);
+}
+
+double bgrSecondsSince(BgrClock::time_point start) {
+  return std::chrono::duration<double>(BgrClock::now() - start).count();
+}
+
+void printBgrPairStage(const char* operation, BgrClock::time_point start) {
